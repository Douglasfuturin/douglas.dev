# Get your key at https://console.x.ai — NÃO deixe o placeholder "xai-..."
# Sem chave real o chat/orquestrador não funciona; o editor de vídeo (/editor) funciona local.
XAI_API_KEY=

# Optional — higher GitHub Search API rate limits for GitHub Scout
# Create at https://github.com/settings/tokens (public_repo or no scope for public search)
# GITHUB_TOKEN=ghp_...

# Notion Guide agent — create an internal integration at https://www.notion.so/my-integrations
# Share the parent page with the integration, then set:
# NOTION_TOKEN=ntn_...
# NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — personal publish queue (Central de Agentes /api/publish)
# When set, queued jobs can be marked sent (stub). Wire real Buffer API later.
# BUFFER_ACCESS_TOKEN=...
