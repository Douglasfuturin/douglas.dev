# Os ids da marca. Não são segredo: as chaves nunca vêm neste pacote.
# O marca/instala.py junta estas linhas no .env.local, sem tocar nas linhas de chave.
#
# VOZ_ID: o clone profissional dele na ElevenLabs (Voices > a voz > copiar ID).
# HEYGEN_LOOK: o look do avatar dele na HeyGen, que ele manda pelo formulário. Vazio vale:
# gerando pelo site, ele escolhe o avatar lá.
VOZ_ID=TROQUE
HEYGEN_LOOK=
