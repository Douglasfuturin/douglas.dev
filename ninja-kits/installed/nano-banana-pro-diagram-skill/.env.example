# Required — Gemini API key for Nano Banana Pro image generation
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — Tavily API key for reference image search (IMAGE placeholders)
# Get one at https://tavily.com
# If not set, image placeholders in SVG blueprints will be skipped
TAVILY_API_KEY=
